{
  "name": "fp-scraper",
  "engines": {
    "node": ">10"
  },
  "version": "2.0.0",
  "description": "simple, non-production ready, web scraper done in js using a functional programming style",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "env NODE_ENV=development nodemon --watch 'src/**/*.ts' --exec node --inspect=127.0.0.1 -r ts-node/register src/index.ts",
    "prepublish": "npm run build",
    "build": "rm -Rf dist/* && tsc ./src/* --outDir dist --declaration",
    "test": "jest --watch",
    "coverage": "jest --watch --coverage"
  },
  "author": "rjbma",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/request": "^2.48.13",
    "jest": "^30.0.0",
    "nodemon": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "curry-types": "^0.2.0",
    "puppeteer": "^24.16.2",
    "request": "^2.88.2"
  }
}
